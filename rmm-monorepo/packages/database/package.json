{
  "name": "@repo/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.ts",
  "dependencies": {
    "@mikro-orm/core": "catalog:",
    "@mikro-orm/postgresql": "catalog:",
    "@mikro-orm/reflection": "catalog:",
    "@repo/types": "workspace:*",
    "dotenv": "^18.0.8",
    "path": "^0.12.7"
  },
  "scripts": {
    "build": "tsc",
    "test:db": "tsx src/test-connection.ts",
    "mikro-orm": "mikro-orm",
    "db:push": "pnpm exec mikro-orm schema:update --run",
    "db:drop": "pnpm exec mikro-orm schema:drop --drop-migrations --run",
    "migration:create": "pnpm exec mikro-orm migration:create",
    "migration:up": "pnpm exec mikro-orm migration:up",
    "migration:down": "pnpm exec mikro-orm migration:down"
  },
  "devDependencies": {
    "@mikro-orm/cli": "^6.6.17",
    "@mikro-orm/migrations": "catalog:",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
