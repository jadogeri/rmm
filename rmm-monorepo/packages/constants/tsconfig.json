{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",           // 🟢 Fix: Must match moduleResolution
    "moduleResolution": "Node16", // 🟢 Fix: Modern, supported algorithm
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "skipLibCheck": true,
    "esModuleInterop": true
  },
  "include": ["src/**/*"]
}
