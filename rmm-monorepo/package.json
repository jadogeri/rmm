{
  "name": "rmm-monorepo",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    
    "// === MIKRO-ORM MIGRATION SCRIPTS ===": "",
    "migration:create": "pnpm --filter @repo/database mikro-orm migration:create",
    "migration:generate": "pnpm --filter @repo/database mikro-orm migration:create --schema",
    "migration:show": "pnpm --filter @repo/database mikro-orm migration:log",
    "migration:run": "pnpm --filter @repo/database mikro-orm migration:up",
    "migration:revert": "pnpm --filter @repo/database mikro-orm migration:down",
    
    "// === MIKRO-ORM SCHEMA SCRIPTS ===": "",
    "schema:drop": "pnpm --filter @repo/database mikro-orm schema:drop --drop-migrations-table --run",
    "schema:sync": "pnpm --filter @repo/database mikro-orm schema:update --run",
    "schema:log": "pnpm --filter @repo/database mikro-orm schema:update --dump",
    
    "// === SEEDING, ANALYSIS, AND UTILITIES ===": "",
    "seeds": "pnpm --filter @repo/database mikro-orm seeder:run",
    "knip": "knip",
    "compodoc": "npx @compodoc/compodoc -p tsconfig.json -s -r 3001",
    
    "// === DOCKER VIRTUALIZATION ENGINE ===": "",
    "docker:prune": "docker builder prune -f",
    "docker:truncate": "docker builder prune -f && docker system prune -f",
    "docker:dev": "docker-compose up",
    "docker:redis": "docker-compose up -d redis",
    "docker:stop": "docker-compose down",
    "docker:prod": "docker-compose -f docker-compose.prod.yml up --build -d"
  },
  "devDependencies": {
    "prettier": "3.9.6",
    "turbo": "^2.11.8",
    "typescript": "7.0.2"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
