{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**"],
      "env":[
        "API_BASE_URL", 
        "API_TIMEOUT", 
        "API_WITH_CREDENTIALS",
        "NEST_API_PORT",
        "NODE_ENV",
        "HELP_DESK_URL",
        "HELP_DESK_API_KEY",
        "DB_USERNAME",
        "DB_PASSWORD",
        "DB_NAME",
        "DB_PORT"
      ]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "check-types": {
      "dependsOn": ["^check-types"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
